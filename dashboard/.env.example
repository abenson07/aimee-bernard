SANITY_PROJECT_ID=18kcd13f
SANITY_DATASET=production
SANITY_API_VERSION=2026-08-14
SANITY_API_WRITE_TOKEN=
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Phase 1 is intake only — categories and the refinement quiz stay hidden.
# Set to exactly "true" to switch categorization on. Anything else (or unset)
# keeps it hidden.
CATEGORIZATION_ENABLED=false

# Site editor (/site): the live site shown in the editor, and the secret both apps share to sign
# draft-preview links. Set the same SITE_PREVIEW_SECRET (any long random string) in the site's settings too.
SITE_URL=http://localhost:4321
SITE_PREVIEW_SECRET=
