SANITY_PROJECT_ID=18kcd13f
SANITY_DATASET=production
SANITY_API_VERSION=2026-08-14
SANITY_API_WRITE_TOKEN=
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Public hostname the dashboard is reached on, no protocol — e.g.
# abernard.vercel.app. Needed because the site proxies /dashboard here, so the
# browser's Origin is the site's domain and Server Actions would otherwise be
# rejected as cross-origin.
DASHBOARD_PUBLIC_HOST=

# Phase 1 is intake only — categories and the refinement quiz stay hidden.
# Set to exactly "true" to switch categorization on. Anything else (or unset)
# keeps it hidden.
CATEGORIZATION_ENABLED=false
