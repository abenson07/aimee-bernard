PUBLIC_SANITY_PROJECT_ID=18kcd13f
PUBLIC_SANITY_DATASET=production

# Server-only — never prefix with PUBLIC_. Needs "Editor" access to create
# pageComment documents and upload screenshot assets. Used only by
# src/pages/api/comments.ts (the review overlay's write endpoint).
SANITY_API_WRITE_TOKEN=

# Visual editing (Studio > Presentation). Leave off for the public site: the
# pages that read page documents render on the server only when this is true.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Server-only "Viewer" token, needed when visual editing is on (drafts + stega).
SANITY_API_READ_TOKEN=

# Contact form (Web3Forms). Optional: the site already has Aimee's key built in. Set this only to override it
# (for example if she creates a new key at web3forms.com). Public by design, so the PUBLIC_ prefix is correct.
PUBLIC_WEB3FORMS_KEY=
