PUBLIC_SANITY_PROJECT_ID=18kcd13f
PUBLIC_SANITY_DATASET=production

# Server-only — never prefix with PUBLIC_. Needs "Editor" access to create
# pageComment documents and upload screenshot assets. Used only by
# src/pages/api/comments.ts (the review overlay's write endpoint).
SANITY_API_WRITE_TOKEN=

# Contact form (Web3Forms). Public by design, so the PUBLIC_ prefix is correct. Aimee gets the key at
# web3forms.com by entering aepbernard@gmail.com; it arrives by email. Also set it in Vercel.
PUBLIC_WEB3FORMS_KEY=
