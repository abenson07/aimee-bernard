---
// Banner + cell mascot (both scroll away with the page) and the floating
// pill nav (fixed). Behavior lives in src/scripts/nav.js, which the page
// loads (shared.js on Educator/Science Communication already includes it).
import "@/styles/site/nav.css";
import "@/styles/site/ask.css";

const links = [
  { href: "/", label: "Home" },
  { href: "/educator", label: "Educator", persona: true },
  { href: "/communicator", label: "Communicator", persona: true },
  { href: "/immunology", label: "Immunologist", persona: true },
  { href: "/work", label: "Work" },
  { href: "/community-outreach", label: "Outreach", persona: true },
  { href: "/contact", label: "Contact" },
];

const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const here = norm(Astro.url.pathname);
// On phones the bottom pill only carries the persona pages, and only shows on them;
// every page gets the full list from the top-right menu.
const onPersonaPage = links.some((l) => l.persona && norm(l.href) === here);
---

<div class="site-header">
  <div class="banner">
    <span>Available for speaking engagements &amp; science communication consulting</span>
    <a href="/contact">Get in touch</a>
  </div>
  <div class="site-header__inner">
    <button type="button" class="nav-mascot" id="navMascot" aria-label="Say hi to the cell">
      <span class="nav-mascot__body"><img src="/site/cells/t-cell.svg" alt="" draggable="false" /></span>
      <span class="nav-mascot__bubble" aria-hidden="true"></span>
    </button>
    <button type="button" class="ask-btn" id="askBtn" aria-label="Ask the B cell a question" aria-expanded="false" aria-controls="askPanel">
      <span class="ask-btn__sign" aria-hidden="true">Ask me<br />a Q?</span>
      <img src="/site/cells/b-cell.svg" alt="" width="56" height="56" draggable="false" />
    </button>
  </div>
</div>
<section class="ask-panel" id="askPanel" role="dialog" aria-label="Ask the B cell" hidden>
  <header class="ask-panel__head">
    <img src="/site/cells/b-cell.svg" alt="" width="28" height="28" />
    <span>Ask the B cell</span>
    <button type="button" class="ask-panel__close" id="askClose" aria-label="Close">&times;</button>
  </header>
  <div class="ask-panel__log" id="askLog" aria-live="polite"></div>
  <div class="ask-panel__chips" id="askChips"></div>
  <form class="ask-panel__form" id="askForm" autocomplete="off">
    <input id="askInput" type="text" maxlength="120" placeholder="Try &ldquo;podcasts&rdquo; or &ldquo;talks 2024&rdquo;" aria-label="Your question" enterkeyhint="send" />
    <button type="submit">Ask</button>
  </form>
  <footer class="ask-panel__demo" id="askDemo">
    <span>Demo:</span>
    <button type="button" data-mode="search">Search</button>
    <button type="button" data-mode="chat">Chat</button>
  </footer>
</section>
<button type="button" class="menu-btn" id="menuBtn" aria-label="Menu" aria-expanded="false" aria-controls="menuSheet">
  <span class="menu-btn__bars" aria-hidden="true"></span>
</button>
<div class="menu-sheet" id="menuSheet" hidden>
  <ul class="menu-sheet__list">
    {
      links.map((l) => {
        const current = norm(l.href) === here;
        return (
          <li>
            <a href={l.href} class:list={["menu-sheet__link", current && "is-current"]} aria-current={current ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
<nav class:list={["pill-nav", onPersonaPage && "pill-nav--persona"]} id="pillNav" aria-label="Main">
  <span class="pill-nav__pill pill-nav__pill--hover" aria-hidden="true"></span>
  <span class="pill-nav__pill pill-nav__pill--active" aria-hidden="true"></span>
  <ul class="pill-nav__list">
    {
      links.map((l) => {
        const current = l.href !== "#" && norm(l.href) === here;
        return (
          <li class:list={[l.persona && "is-persona"]}>
            <a
              href={l.href}
              class:list={["pill-nav__link", current && "is-current"]}
              aria-current={current ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  import "@/scripts/menu.js";
  import "@/scripts/ask-bot.js";
</script>
