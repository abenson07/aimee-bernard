---
// Communicator: the dark feature plus six cards, all items filed under
// Science Communicator, most recently updated first.
import { getSciCommItems } from "@/utils/sanity.ts";
import PressCard from "./PressCard.astro";
import { ISLAND_CACHE, photo } from "./cacheHeaders.ts";

const items = await getSciCommItems(7);
const [feature, ...rest] = items;
Astro.response.headers.set("Cache-Control", ISLAND_CACHE);

const KIND: Record<string, string> = { talk: "Talk", podcast: "Podcast", "press-mentions": "Press", article: "Article" };
const img = photo(feature?.image, 1200);
const external = !!feature?.href && /^https?:/.test(feature.href);
const Tag = feature?.href ? "a" : "div";
---

{
  feature && (
    <Tag class="press-feature fade" href={feature.href ?? undefined} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
      <div class="press-feature__body">
        <div><h3 class="press-feature__title">{feature.title}</h3>{feature.venue && <p class="press-feature__sub">{feature.venue}</p>}</div>
        <div class="press-feature__foot"><hr /><div class="press-feature__meta"><div class="meta"><span>{KIND[feature.kind ?? ""] ?? ""}</span>{feature.date && <span>{feature.date}</span>}</div>{feature.href && <span class="glass-btn"><span class="button-text-mask"><span class="button-text t1">Read now</span><span class="button-text t2">Read now</span></span></span>}</div></div>
      </div>
      <div class="press-feature__img">{img && <img src={img} alt="" loading="lazy" />}</div>
    </Tag>
  )
}
{rest.length > 0 && <div class="press-grid fade">{rest.map((item) => <PressCard item={item} />)}</div>}
