---
interface Props {
  variant: "home" | "educator";
}
const { variant } = Astro.props;
const t = variant === "home" ? "award-title" : "award__title";
const m = variant === "home" ? "award-meta" : "award__meta";
---

{
  Array.from({ length: 6 }).map(() => (
    <div class="award">
      <div class="award-seal"><span class="sk sk--round" style="width:100%;aspect-ratio:1280/1222"></span></div>
      <p class={t} style="width:100%;display:flex;flex-direction:column;align-items:center;gap:8px"><span class="sk sk--line" style="width:80%"></span><span class="sk sk--line" style="width:55%"></span></p>
      <p class={m} style="width:100%;display:flex;justify-content:center"><span class="sk sk--line" style="width:60%;height:11px"></span></p>
    </div>
  ))
}
