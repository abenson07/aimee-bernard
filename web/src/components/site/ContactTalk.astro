---
// Contact: the small talk card over the photo. It shows the same item that is
// featured on the Communicator page.
import { getFeaturedCommunicatorItem } from "@/utils/sanity.ts";
import { ISLAND_CACHE } from "./cacheHeaders.ts";

const item = await getFeaturedCommunicatorItem();
Astro.response.headers.set("Cache-Control", ISLAND_CACHE);
const external = !!item?.href && /^https?:/.test(item.href);
---

{
  item && (
    <a class="contact__talk" href={item.href ?? "/communicator"} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
      <p class="contact__talk-title">{item.title}</p>
      <div class="contact__talk-foot"><span class="contact__talk-tag"><span class="contact__talk-dot"></span>Talk{item.venue ? ` · ${item.venue}` : ""}</span><svg class="contact__talk-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    </a>
  )
}
