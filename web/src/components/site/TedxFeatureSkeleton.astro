---
// Same shape as the real feature, but not live (no scroll scrub) until it loads.
---

<div class="tedx__track" aria-hidden="true">
  <div class="tedx__stage">
    <div class="wrap" style="width:100%">
      <div class="tedx__plate">
        <div class="tedx__head">
          <span class="sk sk--line" style="width:160px;height:12px"></span>
          <span class="sk" style="width:min(30ch,80%);height:clamp(1.8rem,3.3vw,3.1rem)"></span>
        </div>
        <div class="tedx__frame"><span class="sk" style="position:absolute;inset:0;border-radius:0"></span></div>
      </div>
    </div>
  </div>
</div>
