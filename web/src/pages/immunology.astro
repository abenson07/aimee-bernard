---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Awards from "@/components/site/Awards.astro";
import AwardsSkeleton from "@/components/site/AwardsSkeleton.astro";
import PaperStats from "@/components/site/PaperStats.astro";
import PaperStatsSkeleton from "@/components/site/PaperStatsSkeleton.astro";
import Papers from "@/components/site/Papers.astro";
import PapersSkeleton from "@/components/site/PapersSkeleton.astro";
import "@/styles/site/shared.css";
import "@/styles/site/immunology.css";
import { getImage } from "astro:assets";
import bwSrc from "@/assets/site/aimee-bw.png";

const bwUrl = (await getImage({ src: bwSrc, format: "webp", width: 936 })).src;
---

<SiteLayout title="Immunologist">
<SiteHeader />
<div class="page-main" id="pageMain">

<main id="page">
<section class="hero-split">
  <div class="wrap" style="padding:0">
    <div class="hero-split__head">
      <h1 class="display hero-split__title">Why the immune system is worth understanding</h1>
      <div class="hero-split__side is-info"><p>Aimee’s research asks how the body tells friend from foe, and what happens when it gets it wrong.</p></div>
    </div>
    <div class="hero-split__media hero-split__media--landscape"><div><img src="/site/photos/immu-911-slide.webp" alt="Slide: the immune system as a mobile defense system of cells and proteins, with an ambulance labeled Immune Cell saying on my way" style="object-position:50% 50%"></div><div><a href="https://immunologyexplained.aai.org/videos/how-your-immune-system-acts-like-dialing-911/" target="_blank" rel="noopener" aria-label="Watch the video: Activating the Immune System is Like Dialing 911 (Immunology Explained)"><img src="/site/photos/immu-911-video.webp" alt="Aimee in the Immunology Explained video Activating the Immune System is Like Dialing 911" style="object-position:50% 40%"></a></div></div>
  </div>
</section>

<section class="mission-sec has-stats" aria-label="Mission and numbers">
  <p class="mission mission--spread" data-mission>Every moment, your immune system answers one question: friend <span class="m-el m-cell" data-mx="14" data-my="10"><img src="/site/cells/t-cell.svg" alt=""></span> or foe? <span class="m-el m-cell m-cell--bad" data-mx="10" data-my="14"><img src="/site/cells/influenza.svg" alt=""></span> Most of the time, it gets it right. <span class="m-el m-cell" data-mx="12" data-my="9"><img src="/site/cells/antibody.svg" alt=""></span> But sometimes it gets confused, as in allergies and autoimmune diseases.</p>
  <div class="stats-row is-tight">
    <PaperStats server:defer><PaperStatsSkeleton slot="fallback" /></PaperStats>
  </div>
</section>

<section class="awards-row awards-row--recog" aria-label="Awards and recognition">
  <div class="awards-row__head fade">
    <span class="tag-chip">Recognition</span>
    <h2 class="awards-row__title">Mentoring and outreach, recognized.</h2>
  </div>
  <div class="award-grid fade">
    <Awards server:defer variant="educator" group="outreach"><AwardsSkeleton slot="fallback" variant="educator" count={4} /></Awards>
  </div>
</section>

<section class="papers wrap" aria-label="Papers">
  <div class="papers__head fade"><span class="tag-chip">Research</span><h2 class="feature-pair__title">The papers behind the questions</h2></div>
  <ul class="papers__list fade">
    <Papers server:defer><PapersSkeleton slot="fallback" /></Papers>
  </ul>
</section>

<section class="tlas-sec wrap" aria-label="Science Crosstalk">
  <div class="tlas tlas--slim">
    <div class="tlas__grid">
      <div class="tlas__media fade"><img src="/site/photos/substack-collage-1600.webp" alt="" loading="lazy"></div>
      <div class="tlas__content">
        <div class="tlas__copy">
          <span class="tlas__label fade">Substack</span>
          <h2 class="tlas__title fade">Science Crosstalk</h2>
          <p class="tlas__sub fade">Where Science and Communication Collide.</p>
        </div>
        <div class="tlas__foot fade">
          <a class="glass-btn" href="https://aimeepughbernard.substack.com/" target="_blank" rel="noopener"><span class="button-text-mask"><span class="button-text t1">Read on Substack</span><span class="button-text t2">Read on Substack</span></span></a>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

</div>
<footer class="site-footer" id="siteFooter">
<div class="site-footer__inner">
  <div class="site-footer__top">
    <p class="site-footer__big">Curious about how the immune system works?</p>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/educator">Educator</a>
      <a href="/communicator">Communicator</a>
      <a href="/work">Work</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="footer-word" aria-hidden="true"><span class="footer-word__first">Aimee</span><span class="footer-word__last">Pugh-Bernard</span></div>
  <div class="site-footer__bottom"><span>© Aimee Pugh-Bernard</span></div>
</div>
</footer>
<script>
  import "@/scripts/shared.js";
</script>
</SiteLayout>
