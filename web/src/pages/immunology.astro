---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Awards from "@/components/site/Awards.astro";
import AwardsSkeleton from "@/components/site/AwardsSkeleton.astro";
import PaperStats from "@/components/site/PaperStats.astro";
import PaperStatsSkeleton from "@/components/site/PaperStatsSkeleton.astro";
import Papers from "@/components/site/Papers.astro";
import PapersSkeleton from "@/components/site/PapersSkeleton.astro";
import "@/styles/site/shared.css";
import "@/styles/site/immunology.css";
import { getImage } from "astro:assets";
import { getSitePage } from "@/lib/siteContent";
import bwSrc from "@/assets/site/aimee-bw.png";
import tlasSrc from "@/assets/site/tlas-students-working-at-tables.jpg";

const bwUrl = (await getImage({ src: bwSrc, format: "webp", width: 936 })).src;
const tlasUrl = (await getImage({ src: tlasSrc, format: "webp", width: 1024 })).src;
// Text and photos are editable in the dashboard's Site editor; the values here are the fallbacks.
export const prerender = false;
const site = await getSitePage("site-page-immunologist", Astro.request);
site.applyCaching(Astro.response);
const t = site.text;
const e = site.edit;
const heroWide = site.image("hero-photo", { src: "/site/photos/immu-lab-tubes-1600.webp", srcset: "/site/photos/immu-lab-tubes-800.webp 800w, /site/photos/immu-lab-tubes-1600.webp 1600w, /site/photos/immu-lab-tubes-2400.webp 2400w", pos: "60% 40%", alt: "Aimee in a lab coat holding a sample tube" });
const heroSide = site.image("hero-photo-2", { src: bwUrl, pos: "50% 50%", alt: "" });
const tlasPhoto = site.image("tlas-photo", { src: tlasUrl, pos: "50% 50%", alt: "Students working at tables in a Think Like a Scientist session" });
const tlasFeatures = [
  { n: 1, title: "Hands-on experiments", text: "Simple experiments that let kids do science, not just hear about it." },
  { n: 2, title: "A curriculum for teachers", text: "A published curriculum so teachers can run it in their own classrooms." },
  { n: 3, title: "Science at home", text: "Experiments families can try on their own, with video walk-throughs." },
];
---

<SiteLayout title="Immunologist">
<SiteHeader />
<div class="page-main" id="pageMain">

<main id="page">
<section class="hero-split">
  <div class="wrap" style="padding:0">
    <div class="hero-split__head">
      <h1 class="display hero-split__title" {...e("hero-title")}>{t("hero-title", "Why the immune system is worth understanding")}</h1>
      <div class="hero-split__side is-info"><p {...e("hero-blurb")}>{t("hero-blurb", "Aimee’s research asks how the body tells friend from foe, and what happens when it gets it wrong.")}</p></div>
    </div>
    <div class="hero-split__media"><div {...e("hero-photo", "image")}><img src={heroWide.src} srcset={heroWide.srcset} sizes="(max-width: 767px) 100vw, 60vw" alt={heroWide.alt} style={`object-position:${heroWide.pos}`}></div><div {...e("hero-photo-2", "image")}><img src={heroSide.src} srcset={heroSide.srcset} sizes="448px" alt={heroSide.alt} style={`object-position:${heroSide.pos}`}></div></div>
  </div>
</section>

<section class="mission-sec has-stats" aria-label="Mission and numbers">
  <p class="mission" data-mission><span {...e("mission-1")}>{t("mission-1", "Every allergy")}</span> <span class="m-el m-cell" data-mx="14" data-my="10"><img src="/site/cells/t-cell.svg" alt=""></span> <span {...e("mission-2")}>{t("mission-2", "infection")}</span> <span class="m-el m-cell m-cell--bad" data-mx="10" data-my="14"><img src="/site/cells/influenza.svg" alt=""></span> <span {...e("mission-3")}>{t("mission-3", "and autoimmune disease comes down to one question: how does the body decide what to attack? I study that decision")}</span> <span class="m-el m-cell" data-mx="12" data-my="9"><img src="/site/cells/antibody.svg" alt=""></span> <span {...e("mission-4")}>{t("mission-4", "so more people can live well with their immune system.")}</span></p>
  <div class="stats-row is-tight">
    <PaperStats server:defer><PaperStatsSkeleton slot="fallback" /></PaperStats>
  </div>
</section>

<section class="awards-row awards-row--recog" aria-label="Awards and recognition">
  <div class="awards-row__head fade">
    <span class="tag-chip" {...e("recognition-tag")}>{t("recognition-tag", "Recognition")}</span>
    <h2 class="awards-row__title" {...e("recognition-title")}>{t("recognition-title", "Mentoring and outreach, recognized.")}</h2>
  </div>
  <div class="award-grid fade">
    <Awards server:defer variant="educator" group="outreach"><AwardsSkeleton slot="fallback" variant="educator" count={4} /></Awards>
  </div>
</section>

<section class="papers wrap" aria-label="Papers">
  <div class="papers__head fade"><span class="tag-chip" {...e("papers-tag")}>{t("papers-tag", "Research")}</span><h2 class="feature-pair__title" {...e("papers-title")}>{t("papers-title", "The papers behind the questions")}</h2></div>
  <ul class="papers__list fade">
    <Papers server:defer><PapersSkeleton slot="fallback" /></Papers>
  </ul>
</section>

<section class="tlas-sec wrap" aria-label="Think Like a Scientist">
  <div class="tlas">
    <div class="tlas__grid">
      <div class="tlas__media fade" {...e("tlas-photo", "image")}><img src={tlasPhoto.src} srcset={tlasPhoto.srcset} alt={tlasPhoto.alt} style={`object-position:${tlasPhoto.pos}`} loading="lazy"></div>
      <div class="tlas__content">
        <div class="tlas__copy">
          <span class="tlas__label fade" {...e("tlas-label")}>{t("tlas-label", "Outreach")}</span>
          <h2 class="tlas__title fade" {...e("tlas-title")}>{t("tlas-title", "Think Like a Scientist")}</h2>
          <p class="tlas__sub fade" {...e("tlas-sub")}>{t("tlas-sub", "Aimee’s outreach program for elementary schoolers. Hands-on experiments and a curriculum for teachers, built to help kids see themselves as scientists.")}</p>
        </div>
        <div class="tlas__features fade">
          {tlasFeatures.map((f) => (
            <div class="tlas__feature"><h3 class="tlas__feature-title" {...e(`tlas-feature-${f.n}-title`)}>{t(`tlas-feature-${f.n}-title`, f.title)}</h3><p class="tlas__feature-text" {...e(`tlas-feature-${f.n}-text`)}>{t(`tlas-feature-${f.n}-text`, f.text)}</p></div>
          ))}
        </div>
        <div class="tlas__foot fade">
          <a class="glass-btn" href="/programs/think-like-a-scientist"><span class="button-text-mask"><span class="button-text t1">Explore the program</span><span class="button-text t2">Explore the program</span></span></a>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

</div>
<footer class="site-footer" id="siteFooter">
<div class="site-footer__inner">
  <div class="site-footer__top">
    <p class="site-footer__big">Curious about how the immune system works?</p>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/educator">Educator</a>
      <a href="/communicator">Communicator</a>
      <a href="/work">Work</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="footer-word" aria-hidden="true"><span class="footer-word__first">Aimee</span><span class="footer-word__last">Pugh-Bernard</span></div>
  <div class="site-footer__bottom"><span>© Aimee Pugh-Bernard</span></div>
</div>
</footer>
<script>
  import "@/scripts/shared.js";
</script>
{site.preview && <script is:inline src="/edit-mode.js" data-origin={site.dashboardOrigin}></script>}
</SiteLayout>
