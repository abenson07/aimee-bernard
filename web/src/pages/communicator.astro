---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/site/shared.css";
import "@/styles/site/science-communication.css";
import { getImage } from "astro:assets";
import bwSrc from "@/assets/site/aimee-bw.png";
import LogoStrip from "@/components/site/LogoStrip.astro";
import LogoStripSkeleton from "@/components/site/LogoStripSkeleton.astro";
import TedxFeature from "@/components/site/TedxFeature.astro";
import TedxFeatureSkeleton from "@/components/site/TedxFeatureSkeleton.astro";
import SciCommFeed from "@/components/site/SciCommFeed.astro";
import SciCommFeedSkeleton from "@/components/site/SciCommFeedSkeleton.astro";
const bwUrl = (await getImage({ src: bwSrc, format: "webp", width: 520 })).src;
---

<SiteLayout title="Science Communication">
<div class="page-main" id="pageMain">
<SiteHeader />

<section class="hero-split is-fade">
  <div class="wrap" style="padding:0">
    <div class="hero-split__head">
      <h1 class="display hero-split__title">Talking about science so people listen</h1>
      <div class="hero-split__side is-info"><p>Talks, keynotes, and workshops on making immunology clear, honest, and human.</p></div>
    </div>
    <div class="hero-split__media"><div><img src="/site/educator.webp" alt=""></div><div><img src={bwUrl} alt=""></div></div>
  </div>
</section>

<section class="mission-sec has-stats fade-into" aria-label="Mission and numbers">
  <p class="mission" data-mission>The immune system is endlessly fascinating <span class="m-el m-cell" data-mx="14" data-my="10"><img src="/site/cells/t-cell.svg" alt=""></span> and my job, across teaching, communication and outreach <span class="m-el m-cell m-cell--bad" data-mx="10" data-my="14"><img src="/site/cells/influenza.svg" alt=""></span> is to inspire you <span class="m-el m-cell" data-mx="12" data-my="9"><img src="/site/cells/antibody.svg" alt=""></span> to think so too.</p>
  <div class="stats-row is-tight">
    <div class="stat fade"><div class="stat__num">25+</div><p class="stat__desc">Years as an Educator, Immunologist &amp; Communicator</p></div>
    <div class="stat fade"><div class="stat__num">30+</div><p class="stat__desc">Courses taught</p></div>
    <div class="stat fade"><div class="stat__num">100+</div><p class="stat__desc">Talks given</p></div>
    <div class="stat fade"><div class="stat__num">9+</div><p class="stat__desc">Awards received</p></div>
  </div>
</section>

<section class="marquee" aria-label="Appeared with" aria-hidden="true"><div class="marquee__track"><LogoStrip server:defer variant="communicator"><LogoStripSkeleton slot="fallback" variant="communicator" /></LogoStrip></div></section>

<section class="contrib" aria-label="Regularly contributes to">
  <div class="wrap">
    <div class="contrib__head fade"><h2 class="contrib__title">Aimee regularly contributes to...</h2></div>
    <div class="contrib__row fade">
      <a class="contrib__card" href="#"><div class="contrib__media"><img src={bwUrl} alt="" style="object-position:50% 25%" loading="lazy"></div><div class="contrib__info"><h3 class="contrib__name">Unbiased Science</h3><p class="contrib__role">Immunology Expert</p></div></a>
      <a class="contrib__card" href="#"><div class="contrib__media"><img src="/site/immunologist.webp" alt="" style="object-position:70% 50%" loading="lazy"></div><div class="contrib__info"><h3 class="contrib__name">The Immunology Podcast</h3><p class="contrib__role">Guest Expert</p></div></a>
      <a class="contrib__card" href="#"><div class="contrib__media"><img src="/site/communicator.webp" alt="" style="object-position:62% 40%" loading="lazy"></div><div class="contrib__info"><h3 class="contrib__name">The Conversation</h3><p class="contrib__role">Contributing Author</p></div></a>
    </div>
  </div>
</section>

<section class="tedx" data-tedx aria-label="TEDx talk">
  <TedxFeature server:defer><TedxFeatureSkeleton slot="fallback" /></TedxFeature>
</section>

<div class="press wrap fade-to-prefooter">
  <SciCommFeed server:defer><SciCommFeedSkeleton slot="fallback" /></SciCommFeed>
</div>

<section class="prefooter" aria-label="Closing statement">
  <div class="prefooter__circle" aria-hidden="true"></div>
  <div class="prefooter__inner">
    <div class="prefooter__icons" aria-hidden="true">
      <span class="pf-icon" data-mx="50" data-my="30" style="--l:350;--t:22;--w:293.939;--i:240;--r:15deg"><span class="pf-inner"><img src="/site/cells/t-cell.svg" alt="" style="--in:0"></span></span>
      <span class="pf-icon" data-mx="-40" data-my="-20" style="--l:0;--t:26;--w:255.754;--i:187.225;--r:-30deg"><span class="pf-inner"><img src="/site/cells/neutrophil.svg" alt="" style="--in:0"></span></span>
      <span class="pf-icon" data-mx="30" data-my="20" style="--l:27;--t:305;--w:132.668;--i:97.12;--r:-30deg"><span class="pf-inner"><img src="/site/cells/staph.svg" alt="" style="--in:0"></span></span>
      <span class="pf-icon" data-mx="20" data-my="-30" style="--l:719;--t:0;--w:239.054;--i:175;--r:30deg"><span class="pf-inner"><img src="/site/cells/red-blood-cell.svg" alt="" style="--in:0"></span></span>
      <span class="pf-icon" data-mx="-40" data-my="20" style="--l:1010;--t:-80;--w:413.438;--i:302.657;--r:30deg"><span class="pf-inner"><img src="/site/cells/coronavirus.svg" alt="" style="--in:0"></span></span>
    </div>
  </div>
</section>

</div>
<footer class="site-footer" id="siteFooter">
<div class="site-footer__inner">
  <div class="site-footer__top">
    <p class="site-footer__big">Sharing new ideas with new audiences</p>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/educator">Educator</a>
      <a href="/communicator">Communicator</a>
      <a href="/work">Work</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="footer-word" aria-hidden="true"><span class="footer-word__first">Aimee</span><span class="footer-word__last">Pugh-Bernard</span></div>
  <div class="site-footer__bottom"><span>© Aimee Pugh-Bernard</span></div>
</div>
</footer>
<script>
  import "@/scripts/shared.js";
</script>
</SiteLayout>
