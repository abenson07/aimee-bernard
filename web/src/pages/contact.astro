---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/site/shared.css";
import "@/styles/site/contact.css";
---

<SiteLayout title="Contact">
<div class="page-main" id="pageMain">
<SiteHeader />

<main id="page">
<section class="contact" aria-label="Contact">
  <div class="contact__grid">
    <aside class="contact__panel fade">
      <img class="contact__photo" src="/site/photos/contact-portrait-1110.webp" srcset="/site/photos/contact-portrait-700.webp 700w, /site/photos/contact-portrait-1110.webp 1110w" sizes="(max-width: 900px) 100vw, 680px" alt="Aimee Pugh-Bernard" />
    </aside>

    <div class="contact__form-side fade">
      <form class="contact__form" id="contactForm" method="post" action="#">
        <div class="contact__intro">
          <h1 class="display contact__title">Let’s connect.</h1>
          <p class="contact__lede">Have a talk, workshop, or collaboration in mind? Want to talk about teaching, science communication, or outreach? I’d love to hear from you. Send me a note and let’s explore how we can share the wonder of science together.</p>
        </div>
        <hr />
        <div class="contact__fields">
          <label class="field"><span class="field__label">Name</span><input name="name" type="text" placeholder="Your name" required maxlength="256" /></label>
          <label class="field"><span class="field__label">Email</span><input name="email" type="email" placeholder="Email address" required maxlength="256" /></label>
          <label class="field">
            <span class="field__label">What is this about?</span>
            <select name="topic">
              <option value="">Choose one</option>
              <option>Speaking engagement</option>
              <option>Consulting</option>
              <option>Classroom or community visit</option>
              <option>Something else</option>
            </select>
          </label>
          <label class="field"><span class="field__label">Message</span><textarea name="message" placeholder="Message" maxlength="5000" required></textarea></label>
        </div>
        <div class="contact__actions">
          <button type="submit" class="glass-btn contact__send"><span class="button-text-mask"><span class="button-text t1">Send message</span><span class="button-text t2">Send message</span></span></button>
        </div>
      </form>
    </div>
  </div>
</section>
</main>

</div>
<script>
  import "@/scripts/shared.js";
</script>
</SiteLayout>
