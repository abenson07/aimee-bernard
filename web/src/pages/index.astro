---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/site/home.css";
import { getImage } from "astro:assets";
import heroSrc from "@/assets/site/aimee-hero.png";
const heroUrl = (await getImage({ src: heroSrc, format: "webp", width: 1040 })).src;
---

<SiteLayout title="Home">
<!-- structure + style: Direction 2 (first pass) -->
<SiteHeader />

<section class="hero" id="hero-section">
  <div class="hero-role-bg" aria-hidden="true"></div>
  <div class="hero-role-bg" aria-hidden="true"></div>

  <div>
    <h1 class="display hero-name">Aimee <span class="surname">Pugh-Bernard</span></h1>
    <ul class="identity-words" id="identityWords">
      <li><a href="/educator" class="identity-word" data-bg="/site/educator.webp" data-text="Aimee has been teaching at CU Anschutz since 2019.">Educator</a></li>
      <li><a href="/immunology" class="identity-word" data-bg="/site/immunologist.webp" data-text="Aimee is a published immunologist with 12 peer-reviewed papers to her name.">Immunologist</a></li>
      <li><a href="/science-communication" class="identity-word" data-bg="/site/communicator.webp" data-text="Aimee is passionate about making immunology accessible to all.">Communicator</a></li>
    </ul>
  </div>

  <div class="hero-bottom">
    <ul class="hero-socials">
      <li><a href="https://www.instagram.com/funsizeimmuninja/?hl=en" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a></li>
      <li><a href="https://www.tiktok.com/@funsizeimmuninja" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-3.2v13.3a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.2a6.1 6.1 0 1 0 5.2 6.1V8.6a7.5 7.5 0 0 0 4.4 1.4V6.8a4.4 4.4 0 0 1-4.4-4.8z"/></svg></a></li>
      <li><a href="https://aimeepughbernard.substack.com/" target="_blank" rel="noopener" aria-label="Substack"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M4 4h16v2.6H4zM4 8.9h16v2.6H4zM4 13.2h16V22l-8-4.5L4 22z"/></svg></a></li>
      <li><a href="https://bsky.app/profile/funsizeimmuninja.bsky.social" target="_blank" rel="noopener" aria-label="Bluesky"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg></a></li>
    </ul>
  </div>

  <img class="hero-portrait" src={heroUrl} alt="Aimee Pugh-Bernard">
</section>

<section class="section" id="mission-section" aria-label="Mission">
  <div class="main-container">
    <div class="ninja" id="ninja">
    <section class="byq-gem--inline-media-text-01" aria-label="Mission statement">
      <h2 class="byq-gem--inline-media-text-01__line">
        <span class="byq-gem--inline-media-text-01__row">
          <span class="byq-gem--inline-media-text-01__seg">The immune system is</span>
          <span class="byq-gem--inline-media-text-01__seg">endlessly fascinating<span class="ninja__slot" aria-hidden="true"></span>,</span>
        </span>
        <span class="byq-gem--inline-media-text-01__row">
          <span class="byq-gem--inline-media-text-01__seg">and my job &mdash;</span>
          <span class="byq-gem--inline-media-text-01__seg">across teaching<span class="ninja__slot" aria-hidden="true"></span>,</span>
        </span>
        <span class="byq-gem--inline-media-text-01__row">
          <span class="byq-gem--inline-media-text-01__seg">communication<span class="ninja__slot" aria-hidden="true"></span>,</span>
          <span class="byq-gem--inline-media-text-01__seg">and outreach &mdash;</span>
        </span>
        <span class="byq-gem--inline-media-text-01__row">
          <span class="byq-gem--inline-media-text-01__seg">is to inspire you</span>
          <span class="byq-gem--inline-media-text-01__seg">to think so too!<span class="ninja__slot" aria-hidden="true"></span></span>
        </span>
      </h2>
    </section>
    <canvas aria-hidden="true"></canvas>
    <p class="ninja__hint">Swipe the germs &middot; cells just shake it off &middot; <span data-popped>0</span> popped</p>
    </div>
  </div>
</section>

<section class="section" id="outreach-section" aria-label="What she's working on">
  <div class="outreach-inner">
    <div class="outreach-head">
      <h2>What she's <em>working</em> on</h2>
    </div>
    <div class="outreach-grid">
      <article class="outreach-tile">
        <h3>Think Like a Scientist</h3>
        <div class="outreach-media"><img src="/site/communicator.webp" alt="Think Like a Scientist outreach"></div>
        <div class="outreach-copy">
          <p>Hands-on science outreach for elementary and middle-school kids, alongside volunteer scientists at CU Anschutz.</p>
          <a class="outreach-link" href="https://tlasprogram.wordpress.com/" target="_blank" rel="noopener">View work</a>
        </div>
      </article>
      <article class="outreach-tile">
        <h3>Fun Size Immuninja</h3>
        <div class="outreach-media"><img src="/site/immunologist.webp" alt="Fun Size Immuninja"></div>
        <div class="outreach-copy">
          <p>Uses her expertise as an immunologist to break down the science of the immune system for anyone who comes across her page.</p>
          <a class="outreach-link" href="https://www.instagram.com/funsizeimmuninja/?hl=en" target="_blank" rel="noopener">View work</a>
        </div>
      </article>
      <article class="outreach-tile">
        <h3>Teacher Training Program</h3>
        <div class="outreach-media"><img src="/site/educator.webp" alt="Teacher Training Program"></div>
        <div class="outreach-copy">
          <p>Mentors PhD students and postdocs on curriculum design, teaching practice, and assessment.</p>
          <a class="outreach-link" href="https://medschool.cuanschutz.edu/immunology-and-microbiology/dept-resources/teaching-resources/teacher-training-program/overview" target="_blank" rel="noopener">View work</a>
        </div>
      </article>
      <article class="outreach-tile">
        <h3>The World of Autoimmunity</h3>
        <div class="outreach-media"><img src="/site/immunologist.webp" alt="The World of Autoimmunity podcast"></div>
        <div class="outreach-copy">
          <p>Unbiased Science Podcast &middot; April 2025. A recent conversation on autoimmune disease, unpacked for a general audience.</p>
          <a class="outreach-link" href="https://www.youtube.com/watch?v=zV58abJ_nTQ" target="_blank" rel="noopener">View work</a>
        </div>
      </article>
    </div>
    <a class="outreach-all" href="/work">
      All work
      <span class="outreach-all__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</section>

<section class="section stats-pin" id="stats-section" aria-label="By the numbers">
  <div class="main-container">
    <div class="stats-pin__pin-target">
      <div class="stats-pin__viewport">
        <div class="stats-pin__panel is-active" data-panel-index="0" aria-label="By the numbers">
          <div class="panel-label label">By the numbers</div>
          <p class="panel-title display display-md">Twenty-five years in, my goal hasn&rsquo;t changed: make immunology make sense to the people in front of me.</p>
          <div class="stats-thirds">
            <div class="stat">
              <div class="mask" data-reveal><div class="display stat-num slide">25+</div></div>
              <div class="label muted">Years as an educator,<br>scientist &amp; communicator</div>
            </div>
            <div class="stat">
              <div class="mask" data-reveal><div class="display stat-num slide">18</div></div>
              <div class="label muted">Courses taught</div>
            </div>
            <div class="stat">
              <div class="mask" data-reveal><div class="display stat-num slide">21</div></div>
              <div class="label muted">Talks given</div>
            </div>
          </div>
        </div>

        <div class="stats-pin__panel" data-panel-index="1" aria-label="Trusted by / appeared with">
          <div class="panel-label label">Trusted by / appeared with</div>
          <p class="panel-title display display-md">I&rsquo;ve shared this science in classrooms, at conferences, and in newsrooms, from TEDx to The Conversation.</p>
          <div class="cred-marquee" aria-hidden="true">
            <div class="cred-track">
              <span class="cred-logo"><img src="/site/logos/cu-anschutz.png" alt="CU Anschutz" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/cu-denver.png" alt="CU Denver" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/tedx.svg" alt="TEDx" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/aai.png" alt="AAI" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/the-conversation.svg" alt="The Conversation" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/medpagetoday.svg" alt="MedPage Today" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/self.svg" alt="SELF" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/huffpost.svg" alt="HuffPost" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/cu-anschutz.png" alt="CU Anschutz" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/cu-denver.png" alt="CU Denver" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/tedx.svg" alt="TEDx" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/aai.png" alt="AAI" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/the-conversation.svg" alt="The Conversation" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/medpagetoday.svg" alt="MedPage Today" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/self.svg" alt="SELF" loading="lazy"></span>
              <span class="cred-logo"><img src="/site/logos/huffpost.svg" alt="HuffPost" loading="lazy"></span>
            </div>
          </div>
        </div>

