---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/site/shared.css";
import "@/styles/site/educator.css";
import { getImage } from "astro:assets";
import bwSrc from "@/assets/site/aimee-bw.png";
import Awards from "@/components/site/Awards.astro";
import AwardsSkeleton from "@/components/site/AwardsSkeleton.astro";
import CourseGroups from "@/components/site/CourseGroups.astro";
import CourseTilesSkeleton from "@/components/site/CourseTilesSkeleton.astro";
// Courses taught since 2007. Typed in by hand (Aimee: "30+"), not counted from the dashboard.
const coursesTaught = "30+";
const bwUrl = (await getImage({ src: bwSrc, format: "webp", width: 936 })).src;
---

<SiteLayout title="Educator">
<SiteHeader />
<div class="page-main" id="pageMain">

<main id="page">
<section class="hero-split">
  <div class="wrap" style="padding:0">
    <div class="hero-split__head">
      <h1 class="display hero-split__title">Teaching immunology so it sticks</h1>
      <div class="hero-split__side is-info"><p>Since 2007, Aimee has taught {coursesTaught} courses, from first-year medical students and PhD trainees to faculty and community members.</p></div>
    </div>
    <div class="hero-split__media"><div><img src="/site/photos/edu-thc-antibody-1600.webp" srcset="/site/photos/edu-thc-antibody-800.webp 800w, /site/photos/edu-thc-antibody-1600.webp 1600w" sizes="(max-width: 767px) 100vw, 60vw" alt="Aimee presenting to an audience, a slide about B cells and antibodies behind her" style="object-position:50% 40%"></div><div><img src={bwUrl} alt=""></div></div>
  </div>
</section>

<section class="mission-sec has-stats" aria-label="Mission and awards">
  <p class="mission" data-mission>The immune system is endlessly fascinating <span class="m-el m-cell" data-mx="14" data-my="10"><img src="/site/cells/t-cell.svg" alt=""></span> and my job, across teaching, communication and outreach is to inspire you <span class="m-el m-cell" data-mx="12" data-my="9"><img src="/site/cells/antibody.svg" alt=""></span> to think so too.</p>
  <section class="awards-row no-title" aria-label="Awards">
    <div class="award-grid">
      <Awards server:defer variant="educator"><AwardsSkeleton slot="fallback" variant="educator" /></Awards>
    </div>
  </section>
</section>

<section class="courses" aria-label="Courses">
  <div class="wrap">
    <h2 class="courses__title fade">Courses Aimee directs and teaches</h2>
    <div class="courses__grid">
      <CourseGroups server:defer part="tiles"><CourseTilesSkeleton slot="fallback" /></CourseGroups>
    </div>
  </div>
</section>

<section class="feature-pair wrap" aria-label="Programs">
  <div class="feature-pair__head fade"><span class="tag-chip">Programs</span><h2 class="feature-pair__title">Building the next generation of teachers</h2></div>
  <div class="workon">
    <div class="workon__row">
      <a class="workon__card fade" href="https://medschool.cuanschutz.edu/immunology-and-microbiology/dept-resources/teaching-resources/teacher-training-program/overview" target="_blank" rel="noopener">
        <div class="workon__media"><img src="/site/photos/ttp-aimee-1600.webp" srcset="/site/photos/ttp-aimee-800.webp 800w, /site/photos/ttp-aimee-1600.webp 1600w" sizes="(max-width: 767px) 100vw, 45vw" alt="Aimee presenting the Teacher Training Program" style="object-position:50% 50%" loading="lazy"></div>
        <div class="workon__info"><h3 class="workon__name">Teacher Training Program</h3><p class="workon__role">2018&ndash;present</p></div>
      </a>
      <a class="workon__card fade" href="https://cctsi.cuanschutz.edu/training/communicating#ac-workshop-3-2" target="_blank" rel="noopener">
        <div class="workon__media"><img src="/site/photos/cctsi-slide-swapped-nologo-1600.webp" alt="Communicating Your Science to the Public workshop series, Session 1, with Aimee Pugh Bernard and Wendy S. Meyer" style="object-position:0% 50%" loading="lazy"></div>
        <div class="workon__info"><h3 class="workon__name">Communicating Your Science to the Public</h3><p class="workon__role">2023&ndash;present</p></div>
      </a>
    </div>
    <a class="outreach-all" href="/work">
      See all
      <span class="outreach-all__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</section>

</main>
</div>
<!-- Outside the page body: these are position: fixed, and the body is transformed (scaled) at the end of the page. -->
<CourseGroups server:defer part="panels" />
<footer class="site-footer" id="siteFooter">
<div class="site-footer__inner">
  <div class="site-footer__top">
    <p class="site-footer__big">Teaching the next generation of scientists</p>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/educator">Educator</a>
      <a href="/communicator">Communicator</a>
      <a href="/work">Work</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="footer-word" aria-hidden="true"><span class="footer-word__first">Aimee</span><span class="footer-word__last">Pugh-Bernard</span></div>
  <div class="site-footer__bottom"><span>© Aimee Pugh-Bernard</span></div>
</div>
</footer>
<script>
  import "@/scripts/shared.js";
</script>
</SiteLayout>
