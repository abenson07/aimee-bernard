---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/site/shared.css";
import "@/styles/site/educator.css";
import { getImage } from "astro:assets";
import { getSitePage } from "@/lib/siteContent";
import bwSrc from "@/assets/site/aimee-bw.png";
import Awards from "@/components/site/Awards.astro";
import AwardsSkeleton from "@/components/site/AwardsSkeleton.astro";
import CourseGroups from "@/components/site/CourseGroups.astro";
import CourseTilesSkeleton from "@/components/site/CourseTilesSkeleton.astro";
// Courses taught since 2007. Typed in by hand (Aimee: "30+"), not counted from the dashboard.
const coursesTaught = "30+";
// Photos and headings below are editable in the dashboard's Site editor; the values here are the fallbacks.
export const prerender = false;
const site = await getSitePage("site-page-educator", Astro.request);
site.applyCaching(Astro.response);
const heroPhoto = site.image("hero-photo", { src: "/site/photos/edu-thc-antibody-1600.webp", srcset: "/site/photos/edu-thc-antibody-800.webp 800w, /site/photos/edu-thc-antibody-1600.webp 1600w", pos: "50% 40%", alt: "Aimee presenting to an audience, a slide about B cells and antibodies behind her" });
const prog1 = site.image("program-1-photo", { src: "/site/photos/ttp-aimee-1600.webp", srcset: "/site/photos/ttp-aimee-800.webp 800w, /site/photos/ttp-aimee-1600.webp 1600w", pos: "50% 50%", alt: "Aimee presenting the Teacher Training Program" });
const prog2 = site.image("program-2-photo", { src: "/site/photos/cctsi-slide-swapped-nologo-1600.webp", pos: "0% 50%", alt: "Communicating Your Science to the Public workshop series, Session 1, with Aimee Pugh Bernard and Wendy S. Meyer" });
const t = site.text;
const e = site.edit;
const bwUrl = (await getImage({ src: bwSrc, format: "webp", width: 936 })).src;
const heroSide = site.image("hero-photo-2", { src: bwUrl, pos: "50% 50%", alt: "" });
---

<SiteLayout title="Educator">
<SiteHeader />
<div class="page-main" id="pageMain">

<main id="page">
<section class="hero-split" aria-label="Intro">
  <div class="wrap" style="padding:0">
    <div class="hero-split__head">
      <h1 class="display hero-split__title" {...site.edit("hero-title")}>{site.text("hero-title", "Teaching immunology so it sticks")}</h1>
      <div class="hero-split__side is-info"><p {...site.edit("hero-blurb")}>{site.text("hero-blurb", `Since 2007, Aimee has taught ${coursesTaught} courses, from first-year medical students and PhD trainees to faculty and community members.`)}</p></div>
    </div>
    <div class="hero-split__media"><div {...site.edit("hero-photo", "image")}><img src={heroPhoto.src} srcset={heroPhoto.srcset} sizes="(max-width: 767px) 100vw, 60vw" alt={heroPhoto.alt} style={`object-position:${heroPhoto.pos}`}></div><div {...site.edit("hero-photo-2", "image")}><img src={heroSide.src} srcset={heroSide.srcset} sizes="448px" alt={heroSide.alt} style={`object-position:${heroSide.pos}`}></div></div>
  </div>
</section>

<section class="mission-sec has-stats" aria-label="Mission and awards">
  <p class="mission" data-mission><span {...e("mission-1")}>{t("mission-1", "The immune system is endlessly fascinating")}</span> <span class="m-el m-cell" data-mx="14" data-my="10"><img src="/site/cells/t-cell.svg" alt=""></span> <span {...e("mission-2")}>{t("mission-2", "and my goal, across teaching, communication and outreach is to inspire you")}</span> <span class="m-el m-cell" data-mx="12" data-my="9"><img src="/site/cells/antibody.svg" alt=""></span> <span {...e("mission-3")}>{t("mission-3", "to think so too.")}</span></p>
  <section class="awards-row no-title" aria-label="Awards">
    <div class="award-grid">
      <Awards server:defer variant="educator"><AwardsSkeleton slot="fallback" variant="educator" /></Awards>
    </div>
  </section>
</section>

<section class="courses" aria-label="Courses">
  <div class="wrap">
    <h2 class="courses__title fade" {...e("courses-heading")}>{t("courses-heading", "Courses Aimee directs and teaches")}</h2>
    <div class="courses__grid">
      <CourseGroups server:defer part="tiles"><CourseTilesSkeleton slot="fallback" /></CourseGroups>
    </div>
  </div>
</section>

<section class="feature-pair wrap" aria-label="Programs">
  <div class="feature-pair__head fade"><span class="tag-chip" {...e("programs-tag")}>{t("programs-tag", "Programs")}</span><h2 class="feature-pair__title" {...site.edit("programs-heading")}>{site.text("programs-heading", "Building the next generation of teachers")}</h2></div>
  <div class="workon">
    <div class="workon__row">
      <a class="workon__card fade" href="https://medschool.cuanschutz.edu/immunology-and-microbiology/dept-resources/teaching-resources/teacher-training-program/overview" target="_blank" rel="noopener">
        <div class="workon__media" {...site.edit("program-1-photo", "image")}><img src={prog1.src} srcset={prog1.srcset} sizes="(max-width: 767px) 100vw, 45vw" alt={prog1.alt} style={`object-position:${prog1.pos}`} loading="lazy"></div>
        <div class="workon__info"><h3 class="workon__name" {...site.edit("program-1-name")}>{site.text("program-1-name", "Teacher Training Program")}</h3><p class="workon__role" {...site.edit("program-1-sub")}>{site.text("program-1-sub", "2018–present")}</p></div>
      </a>
      <a class="workon__card fade" href="https://cctsi.cuanschutz.edu/training/communicating#ac-workshop-3-2" target="_blank" rel="noopener">
        <div class="workon__media" {...site.edit("program-2-photo", "image")}><img src={prog2.src} srcset={prog2.srcset} sizes="(max-width: 767px) 100vw, 45vw" alt={prog2.alt} style={`object-position:${prog2.pos}`} loading="lazy"></div>
        <div class="workon__info"><h3 class="workon__name" {...site.edit("program-2-name")}>{site.text("program-2-name", "Communicating Your Science to the Public")}</h3><p class="workon__role" {...site.edit("program-2-sub")}>{site.text("program-2-sub", "2023–present")}</p></div>
      </a>
    </div>
    <a class="outreach-all" href="/work">
      <span {...e("programs-see-all")}>{t("programs-see-all", "See all")}</span>
      <span class="outreach-all__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</section>

</main>
</div>
<!-- Outside the page body: these are position: fixed, and the body is transformed (scaled) at the end of the page. -->
<CourseGroups server:defer part="panels" />
<footer class="site-footer" id="siteFooter">
<div class="site-footer__inner">
  <div class="site-footer__top">
    <p class="site-footer__big">Teaching the next generation of scientists</p>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/educator">Educator</a>
      <a href="/communicator">Communicator</a>
      <a href="/work">Work</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="footer-word" aria-hidden="true"><span class="footer-word__first">Aimee</span><span class="footer-word__last">Pugh-Bernard</span></div>
  <div class="site-footer__bottom"><span>© Aimee Pugh-Bernard</span></div>
</div>
</footer>
<script>
  import "@/scripts/shared.js";
</script>
{site.preview && <script is:inline src="/edit-mode.js" data-origin={site.dashboardOrigin}></script>}
</SiteLayout>
